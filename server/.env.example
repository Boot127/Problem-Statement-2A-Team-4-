PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# HLD Section 11/17 specifies MySQL 8; this build targets SQLite for local
# dev (no MySQL server available in this environment). SQLITE_DB_PATH is
# where the shared SQLite database is created on first run — every
# repository in the app (auth, Compliance Content, Work Permits, Reviews,
# Newsletters) connects to this same file via config/database.js. Leave
# unset to default to server/database/hrckmp.db.
SQLITE_DB_PATH=

# The whole team's backend migrates to Postgres/Neon for production this
# way — every repository goes through config/database.js, which picks
# Postgres or SQLite based on DB_PROVIDER below. Get both URLs from Neon
# Console -> Project -> Connect: use the pooled URL for the application
# (DATABASE_URL) and the direct URL for migrations (DATABASE_URL_DIRECT).
# Never expose either value to Vite/React or commit a real connection
# string. Leave DB_PROVIDER=sqlite (or unset) for local dev; set it to
# `postgres` only once DATABASE_URL is real and
# `npm run db:migrate && npm run db:migrate:sqlite-to-postgres && npm run db:verify`
# have all passed (see server/README.md).
DB_PROVIDER=sqlite
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ENABLE_DEV_SEED=false

# MySQL vars below are for the eventual shared foundation database if it
# moves off SQLite (not used yet).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=hrckmp

JWT_SECRET=
JWT_EXPIRES_IN=1d

# HLD Section 16 names Anthropic Claude, but that has no ongoing free tier.
# This is a Groq API key instead (https://console.groq.com/keys — free,
# no credit card). Leave blank to run the AI writing assistant on an
# offline heuristic fallback instead (see src/services/aiService.js).
AI_API_KEY=

# Optional Work Permit source-document extraction provider (Dev 2). Mock
# mode requires no key and is the default, so uploading source documents
# never depends on an external AI API unless you opt in.
PERMIT_AI_PROVIDER=mock
PERMIT_AI_ENDPOINT=
PERMIT_AI_API_KEY=
PERMIT_AI_MODEL=
