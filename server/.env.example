PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# HLD Section 11/17 specifies MySQL 8; this build targets SQLite for local
# dev (no MySQL server available in this environment). SQLITE_DB_PATH is
# where the shared SQLite database is created on first run — both
# config/db.js (shared foundation: auth/records) and config/sqliteDb.js
# (Work Permits) point at the same file. Leave unset to default to
# server/database/hrckmp.db.
SQLITE_DB_PATH=

# Dev 2 (Work Permit Management) is separately migrating to Postgres/Neon for
# production. Get both URLs from Neon Console -> Project -> Connect. Use the
# pooled URL for the application and the direct URL for migrations. Never
# expose either value to Vite/React or commit a real connection string.
# Leave DB_PROVIDER=sqlite (or unset) for local dev — that's what the shared
# foundation (auth, compliance_records) and the SQLite-backed part of Work
# Permits both use; only set it to `postgres` once DATABASE_URL is real.
DB_PROVIDER=sqlite
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ENABLE_DEV_SEED=false

# MySQL vars below are for the eventual shared foundation database if it
# moves off SQLite (not used yet).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=hrckmp

JWT_SECRET=
JWT_EXPIRES_IN=1d

# HLD Section 16 names Anthropic Claude, but that has no ongoing free tier.
# This is a Groq API key instead (https://console.groq.com/keys — free,
# no credit card). Leave blank to run the AI writing assistant on an
# offline heuristic fallback instead (see src/services/aiService.js).
AI_API_KEY=

# Optional Work Permit source-document extraction provider (Dev 2). Mock
# mode requires no key and is the default, so uploading source documents
# never depends on an external AI API unless you opt in.
PERMIT_AI_PROVIDER=mock
PERMIT_AI_ENDPOINT=
PERMIT_AI_API_KEY=
PERMIT_AI_MODEL=
