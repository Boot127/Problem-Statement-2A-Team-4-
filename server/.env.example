PORT=5000

# HLD Section 11/17 specifies MySQL 8; this build targets SQLite for local
# dev (no MySQL server available in this environment). DB_FILE is where the
# SQLite database is created on first run. To swap back to MySQL later,
# reintroduce DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME and rewrite
# src/config/db.js against mysql2 (already a dependency) using the DDL in
# docs/HIGH_LEVEL_DESIGN.md Section 12.
DB_FILE=./database/hrckmp.db

JWT_SECRET=
JWT_EXPIRES_IN=1d

# HLD Section 16 names Anthropic Claude, but that has no ongoing free tier.
# This is a Groq API key instead (https://console.groq.com/keys — free,
# no credit card). Leave blank to run the AI writing assistant on an
# offline heuristic fallback instead (see src/services/aiService.js).
AI_API_KEY=
