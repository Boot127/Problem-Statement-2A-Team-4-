PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Dev 2 database. Get both URLs from Neon Console -> Project -> Connect.
# Use the pooled URL for the application and the direct URL for migrations.
# Never expose either value to Vite/React or commit a real connection string.
DB_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ENABLE_DEV_SEED=false

# Legacy rollback/migration source only. Leave unset to use
# server/database/hrckmp.db when DB_PROVIDER=sqlite.
SQLITE_DB_PATH=

# MySQL vars below are for the eventual shared database (not used by the
# SQLite-backed Work Permit feature yet).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=hrckmp
JWT_SECRET=
JWT_EXPIRES_IN=1d
AI_API_KEY=
