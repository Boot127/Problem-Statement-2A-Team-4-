PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# HLD Section 11/17 specifies MySQL 8; this build targets SQLite for local
# dev (no MySQL server available in this environment). SQLITE_DB_PATH is
# where the shared SQLite database is created on first run — both
# config/db.js (shared foundation: auth/records) and config/sqliteDb.js
# (Work Permits) point at the same file. Leave unset to default to
# server/database/hrckmp.db. To swap to MySQL later, use the DB_* vars below
# and rewrite config/db.js against mysql2 (already a dependency) using the
# DDL in docs/HIGH_LEVEL_DESIGN.md Section 12.
SQLITE_DB_PATH=

# MySQL vars below are for the eventual shared production database (not used
# by the SQLite-backed local dev setup yet).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=hrckmp

JWT_SECRET=
JWT_EXPIRES_IN=1d

# HLD Section 16 names Anthropic Claude, but that has no ongoing free tier.
# This is a Groq API key instead (https://console.groq.com/keys — free,
# no credit card). Leave blank to run the AI writing assistant on an
# offline heuristic fallback instead (see src/services/aiService.js).
AI_API_KEY=
